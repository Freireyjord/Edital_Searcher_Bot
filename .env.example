# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA faça commit do ".env".

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (somente backend/robô). Painel Supabase > Settings > API
SUPABASE_SERVICE_KEY=coloque_aqui_a_service_role_key

# --- Ollama (IA local) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:14b-instruct

# --- SMTP (relay corporativo) ---
SMTP_SERVIDOR=seu-relay.mail.protection.outlook.com
SMTP_PORTA=25
SMTP_REMETENTE=seu.email@dominio.org.br

# --- PDFs / OCR (opcionais) ---
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# POPPLER_PATH=C:\\poppler\\Library\\bin
# MAX_PDFS_POR_EDITAL=3
# MAX_PDF_MB=30
# OCR_MAX_PAGINAS=10

# --- Relatório semanal (opcionais; padrão: segunda às 07:00, horário desta máquina) ---
# REPORT_DIA_SEMANA=0        # 0=segunda ... 6=domingo
# REPORT_HORA=7
# REPORT_MINUTO=0
# REPORT_MAX_PARALELO=20
# REPORT_TOLERANCIA_DESCOBERTA_DIAS=0   # >0: inclui editais iniciados nos N dias anteriores só descobertos na semana
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_THINK=off           # off | auto | on  (raciocínio de modelos Qwen3.5/DeepSeek-R1; 'off' é bem mais rápido)
# IA_MAX_TIMEOUTS_SEGUIDOS=3
